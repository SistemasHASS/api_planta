<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>planta-base-api-5f3c2a1e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <!-- Api conoce Domain (contratos) y referencia Application e Infrastructure
       solo para registrarlos en Program.cs. -->
  <ItemGroup>
    <ProjectReference Include="..\Planta.Domain\Planta.Domain.csproj" />
    <ProjectReference Include="..\Planta.Application\Planta.Application.csproj" />
    <ProjectReference Include="..\Planta.Infrastructure\Planta.Infrastructure.csproj" />
  </ItemGroup>

</Project>
