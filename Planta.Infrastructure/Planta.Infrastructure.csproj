<Project Sdk="Microsoft.NET.Sdk">

  <!-- Infrastructure solo depende de Domain (implementa sus contratos). -->
  <ItemGroup>
    <ProjectReference Include="..\Planta.Domain\Planta.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EPPlus" Version="7.7.0" />
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <!-- Dependencia transitiva (EPPlus y Microsoft.Data.SqlClient la traen en 9.0.x, vulnerable).
       Fijada a la versión corregida: GHSA-846f-f764-76mx y GHSA-2fmv-rv2c-59x7.
       Quitar cuando EPPlus y SqlClient traigan una versión >= 10.0.13. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
